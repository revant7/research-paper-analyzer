# Environment (development, testing, production)
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/research_rag
# For local dev SQLite without Postgres:
# DATABASE_URL=sqlite+aiosqlite:///./research_rag.db

# JWT Security
JWT_SECRET_KEY=generate-a-secure-random-64-character-key-for-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# LLM Provider (openai, huggingface, mock)
LLM_PROVIDER=mock
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=

# Embedding
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.3
LLM_TEMPERATURE=0.7

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data

# CORS
FRONTEND_URL=http://localhost:5173
